---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Crumbs from "../../components/Crumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import { rs, sizeSlug, brandSlug } from "../../lib/shop";
import { euText, fullSize, has, chartKeyFor, CHARTS } from "../../lib/sizes";

const { allProducts, available, categoryOf, settings, waLink, returnSummary } = Astro.locals.shop;
const p = allProducts.find((x) => x.slug === Astro.params.slug);
if (!p) return Astro.rewrite("/404/");
const sold = p.status === "sold";
const s = fullSize(p.size, p.brand);
const chartKey = chartKeyFor(p.brand);
const chartName = chartKey ? CHARTS[chartKey].name : "";
// UK, US and foot length come from the brand's own chart. Brands without a published chart show EU only.
const sizeNote = has(s.uk)
  ? chartName ? `UK, US and foot length follow the ${chartName} size chart.` : "UK, US and foot length are for this pair."
  : chartKey === "adidas"
    ? "adidas sells whole sizes and thirds (42, 42 2/3, 43 1/3), so this size is not on the adidas chart. The size guide has the full adidas table."
    : `${p.brand} prints EU sizes only, and fit changes from brand to brand.`;
const cat = categoryOf(p.size.eu);
const word = p.condition >= 9 ? "Like new" : p.condition >= 8 ? "Very good" : p.condition >= 7 ? "Good" : "Fair";
const more = [
  ...available().filter((o) => o.slug !== p.slug && cat && categoryOf(o.size.eu)?.slug === cat.slug),
  ...available().filter((o) => o.slug !== p.slug && !(cat && categoryOf(o.size.eu)?.slug === cat.slug)),
].slice(0, 4);
const ask = waLink(`Hi Anchor Shoes, I am asking about ${p.name} (EU ${euText(p.size.eu)}).`);
const similar = waLink(`Hi Anchor Shoes, please tell me when a pair like ${p.name} in EU ${euText(p.size.eu)} comes in.`);
const trail = [
  { label: "Shop by size", href: "/shoes/" },
  ...(cat ? [{ label: cat.label, href: `/size/${cat.slug}/` }] : []),
  { label: p.name },
];
---

<Base title={`${p.name}, EU ${euText(p.size.eu)}`} nav="shop" description={`${p.brand} ${p.name} in EU ${euText(p.size.eu)}, condition ${p.condition}/10. ${rs(p.price)}. Cash on delivery.`}>
  <div class="page">
    <Crumbs trail={trail} />
    <div class="pdp">
      <div class="gallery" data-gallery>
        <div class="gallery__main" data-frame>
          <img src={p.photos[0]} alt={`${p.name}, photo 1${p.photos.length > 1 ? ` of ${p.photos.length}` : ""}`} width="576" height="1024" data-main data-name={p.name} />
          {sold && <span class="badge">Sold</span>}
          {p.photos.length > 1 && (
            <>
              <button type="button" class="gallery__nav gallery__nav--prev" data-prev aria-label="Previous photo"><Icon name="left" size={22} /></button>
              <button type="button" class="gallery__nav gallery__nav--next" data-next aria-label="Next photo"><Icon name="right" size={22} /></button>
              <span class="gallery__count" data-counter aria-live="polite">1 / {p.photos.length}</span>
            </>
          )}
        </div>
        {p.photos.length > 1 && (
          <div class="gallery__thumbs">
            {p.photos.map((src, i) => (
              <button type="button" data-thumb={src} aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? "true" : "false"}><img src={src} alt="" width="64" height="114" /></button>
            ))}
          </div>
        )}
      </div>

      <div class="pdp__info">
        <p class="pdp__brand"><a href={`/brand/${brandSlug(p.brand)}/`} style="text-decoration:none">{p.brand}</a></p>
        <h1>{p.name}</h1>
        <p class="pdp__price">{rs(p.price)}</p>
        <p class="small muted">Delivery charges are paid in advance.</p>
        <div class="tag-row"><span class="tagc">{word}</span><span class="tagc">{p.colour}</span>{sold ? <span class="tagc">Sold</span> : <span class="tagc">One pair only</span>}</div>

        <div class="opt">
          <h2>Size</h2>
          <div class="pills" style="margin:0">
            <span class="pill" aria-current="page">EU {euText(s.eu)}</span>
            {has(s.uk) && <span class="pill">UK {s.uk}</span>}
            {has(s.us) && <span class="pill">US {s.us}</span>}
            {has(s.cm) && <span class="pill">Foot {s.cm} cm</span>}
            {p.insole && <span class="pill">Insole {p.insole} cm</span>}
          </div>
          <small class="m">Fit changes by brand. <a href="/size-guide/">See the size guide</a>.</small>
        </div>

        <div class="opt">
          <h2>Condition: {p.condition} out of 10</h2>
          <div class="meter" aria-hidden="true">{Array.from({ length: 10 }, (_, i) => <i class={i < p.condition ? "on" : ""}></i>)}</div>
          <small class="m">{p.flaws}</small>
        </div>

        {sold ? (
          <div class="sold-note">
            <b>This pair has been sold.</b>
            <p class="muted" style="margin-top:4px">There may be something similar. See other pairs in your size or ask us.</p>
            <p style="margin-top:12px">
              {cat && <a class="btn btn--line" href={`/size/${cat.slug}/${sizeSlug(p.size.eu)}/`}>More in EU {euText(p.size.eu)}</a>}
              {similar && <a class="btn btn--line" style="margin-left:8px" href={similar} rel="noopener">Ask us</a>}
            </p>
          </div>
        ) : (
          <div class="buy" data-buybox>
            <div class="buy__row">
              <button class="btn btn--brass" type="button" data-add={p.slug} data-in-label="In your cart, view" data-out-label="Add to cart"><span data-label>Add to cart</span></button>
              <button class="wish-btn" type="button" data-wish={p.slug} aria-pressed="false" aria-label="Save this pair"><Icon name="heart" /></button>
            </div>
            <button class="btn" type="button" data-buy={p.slug}>Buy now, pay on delivery</button>
          </div>
        )}

        <div class="assure">
          <div><Icon name="truck" size={20} /> Cash on delivery</div>
          <div><Icon name="camera" size={20} /> Real photos of this exact pair</div>
          <div><Icon name="package" size={20} /> Delivery charges are paid in advance</div>
        </div>

        <details class="acc" open>
          <summary>Condition and flaws <Icon name="down" size={18} /></summary>
          <div class="acc__in"><p>Rated {p.condition} out of 10 ({word.toLowerCase()}).</p><p>{p.flaws}</p></div>
        </details>
        <details class="acc">
          <summary>Size and fit <Icon name="down" size={18} /></summary>
          <div class="acc__in">
            <p>EU {euText(s.eu)}{has(s.uk) ? ` · UK ${s.uk} · US ${s.us}` : ""}{has(s.cm) ? ` · foot length about ${s.cm} cm` : ""}.</p>
            {p.insole && <p>Measured insole length of this pair: {p.insole} cm.</p>}
            <p>{sizeNote} If you are between two sizes, choose the larger one, or message us and we will help. <a href="/size-guide/">Size guide</a></p>
          </div>
        </details>
        <details class="acc">
          <summary>Delivery and payment <Icon name="down" size={18} /></summary>
          <div class="acc__in">
            <p>You pay for the pair in cash when the parcel arrives. Delivery charges are paid in advance, before the parcel is sent.</p>
            <p>{settings.deliveryFee ? `Delivery charges: ${settings.deliveryFee}.` : "We tell you the delivery charges when you place your order."}{settings.cities ? ` We deliver to: ${settings.cities}.` : ""}</p>
          </div>
        </details>
        <details class="acc">
          <summary>Returns <Icon name="down" size={18} /></summary>
          <div class="acc__in"><p>{returnSummary() || "Read our return policy for exchanges and refunds."} <a href="/returns/">Full return policy</a></p></div>
        </details>

        <p style="margin-top:14px">
          <a class="share" href="https://wa.me/" data-share={p.name} rel="noopener">Share this pair on WhatsApp</a>
          {ask && <> · <a class="share" href={ask} rel="noopener">Ask about this pair</a></>}
        </p>
      </div>
    </div>

    {more.length > 0 && (
      <section class="section">
        <div class="section__head"><h2>More pairs</h2><a class="link" href="/shoes/">View all</a></div>
        <ul class="grid">{more.map((o) => <ProductCard p={o} idx={allProducts.indexOf(o)} />)}</ul>
      </section>
    )}
  </div>

  {!sold && (
    <div class="stickybar" data-sticky aria-label="Quick buy">
      <div><small>{p.brand} · EU {euText(p.size.eu)}</small><b>{rs(p.price)}</b></div>
      <button class="btn btn--brass" type="button" data-add={p.slug} data-in-label="In your cart, view" data-out-label="Add to cart"><span data-label>Add to cart</span></button>
    </div>
  )}
</Base>

<script>
  // Photo gallery: previous / next buttons (wrap around), swipe on a phone, arrow keys, thumbnails.
  const g = document.querySelector<HTMLElement>("[data-gallery]");
  const main = g?.querySelector<HTMLImageElement>("[data-main]");
  const thumbs = Array.from(g?.querySelectorAll<HTMLButtonElement>("[data-thumb]") ?? []);
  if (g && main && thumbs.length > 1) {
    const urls = thumbs.map((b) => b.dataset.thumb!);
    const counter = g.querySelector<HTMLElement>("[data-counter]");
    const name = main.dataset.name ?? "";
    let at = 0;
    const show = (n: number) => {
      at = (n + urls.length) % urls.length;
      main.src = urls[at];
      main.alt = `${name}, photo ${at + 1} of ${urls.length}`;
      thumbs.forEach((b, k) => b.setAttribute("aria-current", String(k === at)));
      if (counter) counter.textContent = `${at + 1} / ${urls.length}`;
      // warm the neighbours so the next tap is instant
      [urls[(at + 1) % urls.length], urls[(at - 1 + urls.length) % urls.length]].forEach((u) => { new Image().src = u; });
    };
    thumbs.forEach((b, k) => b.addEventListener("click", () => show(k)));
    g.querySelector("[data-prev]")?.addEventListener("click", () => show(at - 1));
    g.querySelector("[data-next]")?.addEventListener("click", () => show(at + 1));
    g.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); show(at + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); show(at - 1); }
    });
    // swipe: a clearly sideways drag changes the photo; an up/down drag still scrolls the page
    const frame = g.querySelector<HTMLElement>("[data-frame]");
    let x0 = 0, y0 = 0;
    frame?.addEventListener("touchstart", (e) => { x0 = e.changedTouches[0].clientX; y0 = e.changedTouches[0].clientY; }, { passive: true });
    frame?.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) show(at + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }

  const sticky = document.querySelector<HTMLElement>("[data-sticky]");
  const box = document.querySelector<HTMLElement>("[data-buybox]");
  // Show the quick-buy bar once the main buy buttons have scrolled off the top. A scroll check (not an
  // IntersectionObserver) so it also works when the page jumps past the buy box in one go.
  if (sticky && box) {
    let queued = false;
    const update = () => { queued = false; sticky.classList.toggle("show", box.getBoundingClientRect().bottom < 0); };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    update();
  }

  const share = document.querySelector<HTMLAnchorElement>("[data-share]");
  if (share) share.href = "https://wa.me/?text=" + encodeURIComponent(`${share.dataset.share} at Anchor Shoes: ${location.href}`);
</script>
