---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Crumbs from "../../components/Crumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import { allProducts, available, categoryOf, rs, settings, waLink, sizeSlug, type Product } from "../../lib/shop";
import { fullSize, fmt } from "../../lib/sizes";

export function getStaticPaths() {
  return allProducts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const sold = p.status === "sold";
const s = fullSize(p.size);
const cat = categoryOf(p.size.eu);
const word = p.condition >= 9 ? "Like new" : p.condition >= 8 ? "Very good" : p.condition >= 7 ? "Good" : "Fair";
const more = [
  ...available().filter((o) => o.slug !== p.slug && cat && categoryOf(o.size.eu)?.slug === cat.slug),
  ...available().filter((o) => o.slug !== p.slug && !(cat && categoryOf(o.size.eu)?.slug === cat.slug)),
].slice(0, 4);
const ask = waLink(`Hi Anchor Shoes, I am asking about ${p.name} (EU ${p.size.eu}).`);
const similar = waLink(`Hi Anchor Shoes, please tell me when a pair like ${p.name} in EU ${p.size.eu} comes in.`);
const trail = [
  { label: "Shop by size", href: "/shoes/" },
  ...(cat ? [{ label: cat.label, href: `/size/${cat.slug}/` }] : []),
  { label: p.name },
];
---

<Base title={`${p.name}, EU ${p.size.eu}`} nav="shop" description={`${p.brand} ${p.name} in EU ${p.size.eu}, condition ${p.condition}/10. ${rs(p.price)}. Cash on delivery.`}>
  <div class="page">
    <Crumbs trail={trail} />
    <div class="pdp">
      <div class="gallery" data-gallery>
        <div class="gallery__main">
          <img src={p.photos[0]} alt={`${p.name}, photo 1`} width="640" height="800" data-main />
          {sold && <span class="badge">Sold</span>}
        </div>
        {p.photos.length > 1 && (
          <div class="gallery__thumbs">
            {p.photos.map((src, i) => (
              <button type="button" data-thumb={src} aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? "true" : "false"}><img src={src} alt="" width="64" height="80" /></button>
            ))}
          </div>
        )}
      </div>

      <div class="pdp__info">
        <p class="pdp__brand">{p.brand}</p>
        <h1>{p.name}</h1>
        <p class="pdp__price">{rs(p.price)}</p>
        <p class="small muted">Delivery fee is confirmed when we call you.</p>
        <div class="tag-row"><span class="tagc">{word}</span><span class="tagc">{p.colour}</span>{sold ? <span class="tagc">Sold</span> : <span class="tagc">One pair only</span>}</div>

        <div class="opt">
          <h2>Size</h2>
          <div class="pills" style="margin:0">
            <span class="pill" aria-current="page">EU {s.eu}</span>
            <span class="pill">UK {fmt(s.uk)}</span>
            <span class="pill">US {fmt(s.us)}</span>
            <span class="pill">{fmt(s.cm)} cm</span>
          </div>
          <small class="m">Fit changes by brand. <a href="/size-guide/">See the size guide</a>.</small>
        </div>

        <div class="opt">
          <h2>Condition: {p.condition} out of 10</h2>
          <div class="meter" aria-hidden="true">{Array.from({ length: 10 }, (_, i) => <i class={i < p.condition ? "on" : ""}></i>)}</div>
          <small class="m">{p.flaws}</small>
        </div>

        {sold ? (
          <div class="sold-note">
            <b>This pair has been sold.</b>
            <p class="muted" style="margin-top:4px">There may be something similar. See other pairs in your size or ask us.</p>
            <p style="margin-top:12px">
              {cat && <a class="btn btn--line" href={`/size/${cat.slug}/${sizeSlug(p.size.eu)}/`}>More in EU {p.size.eu}</a>}
              {similar && <a class="btn btn--line" style="margin-left:8px" href={similar} rel="noopener">Ask us</a>}
            </p>
          </div>
        ) : (
          <div class="buy" data-buybox>
            <div class="buy__row">
              <button class="btn btn--brass" type="button" data-add={p.slug} data-in-label="In your cart, view" data-out-label="Add to cart"><span data-label>Add to cart</span></button>
              <button class="wish-btn" type="button" data-wish={p.slug} aria-pressed="false" aria-label="Save this pair"><Icon name="heart" /></button>
            </div>
            <button class="btn" type="button" data-buy={p.slug}>Buy now, pay on delivery</button>
          </div>
        )}

        <div class="assure">
          <div><Icon name="truck" size={20} /> Cash on delivery</div>
          <div><Icon name="phone" size={20} /> We call you to confirm before sending</div>
          <div><Icon name="package" size={20} /> Sent by TCS with a tracking number</div>
        </div>

        <details class="acc" open>
          <summary>Condition and flaws <Icon name="down" size={18} /></summary>
          <div class="acc__in"><p>Rated {p.condition} out of 10 ({word.toLowerCase()}).</p><p>{p.flaws}</p></div>
        </details>
        <details class="acc">
          <summary>Size and fit <Icon name="down" size={18} /></summary>
          <div class="acc__in"><p>EU {s.eu} · UK {fmt(s.uk)} · US {fmt(s.us)} · about {fmt(s.cm)} cm foot length.</p><p>This is an approximate men's conversion. If you are between sizes, message us and we will help you choose.</p></div>
        </details>
        <details class="acc">
          <summary>Delivery and payment <Icon name="down" size={18} /></summary>
          <div class="acc__in">
            <p>We call and message you on WhatsApp to confirm, then send the pair by TCS. You pay cash on delivery and get a tracking number.</p>
            <p>{settings.deliveryFee ? `Delivery fee: ${settings.deliveryFee}.` : "The delivery fee is confirmed when we call you."}{settings.cities ? ` We deliver to: ${settings.cities}.` : ""}</p>
          </div>
        </details>
        <details class="acc">
          <summary>Returns <Icon name="down" size={18} /></summary>
          <div class="acc__in"><p>{settings.returnPolicy || "Our return and exchange policy will be shown here. If you are unsure about a pair, ask us before you order."}</p></div>
        </details>

        <p style="margin-top:14px">
          <a class="share" href="https://wa.me/" data-share={p.name} rel="noopener">Share this pair on WhatsApp</a>
          {ask && <> · <a class="share" href={ask} rel="noopener">Ask about this pair</a></>}
        </p>
      </div>
    </div>

    {more.length > 0 && (
      <section class="section">
        <div class="section__head"><h2>More pairs</h2><a class="link" href="/shoes/">View all</a></div>
        <ul class="grid">{more.map((o) => <ProductCard p={o} idx={allProducts.indexOf(o)} />)}</ul>
      </section>
    )}
  </div>

  {!sold && (
    <div class="stickybar" data-sticky aria-label="Quick buy">
      <div><small>{p.brand} · EU {p.size.eu}</small><b>{rs(p.price)}</b></div>
      <button class="btn btn--brass" type="button" data-add={p.slug} data-in-label="In your cart, view" data-out-label="Add to cart"><span data-label>Add to cart</span></button>
    </div>
  )}
</Base>

<script>
  const g = document.querySelector<HTMLElement>("[data-gallery]");
  const main = g?.querySelector<HTMLImageElement>("[data-main]");
  g?.querySelectorAll<HTMLButtonElement>("[data-thumb]").forEach((b) =>
    b.addEventListener("click", () => {
      if (main) main.src = b.dataset.thumb!;
      g.querySelectorAll("[data-thumb]").forEach((o) => o.setAttribute("aria-current", String(o === b)));
    }),
  );

  const sticky = document.querySelector<HTMLElement>("[data-sticky]");
  const box = document.querySelector<HTMLElement>("[data-buybox]");
  if (sticky && box && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => sticky.classList.toggle("show", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(box);
  }

  const share = document.querySelector<HTMLAnchorElement>("[data-share]");
  if (share) share.href = "https://wa.me/?text=" + encodeURIComponent(`${share.dataset.share} at Anchor Shoes: ${location.href}`);
</script>
