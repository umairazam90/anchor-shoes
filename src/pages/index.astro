---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
const { allCategories, allProducts, allBrands, available, productsIn, waLink, settings } = Astro.locals.shop;

const fresh = [...available()].reverse();
const hero = fresh.slice(0, 3);
const arrivals = fresh.slice(0, 8);
const tiles = allCategories.map((c) => {
  const items = productsIn(c);
  const open = items.filter((p) => p.status === "available");
  return { ...c, n: open.length, img: (open[0] ?? items[0])?.photos[0] };
});
const brands = allBrands();
const ask = waLink("Hi Anchor Shoes, I am looking for a pair in size ___.");
---

<Base>
  <section class="hero">
    <div class="hero__in">
      <div>
        <p class="eyebrow">{settings.tagline}</p>
        <h1>Good shoes, honestly described</h1>
        <p class="lead">Real photos of the exact pair, the condition out of 10, and every flaw written down. Pay cash when it arrives.</p>
        <div class="hero__cta">
          <a class="btn btn--brass" href="#sizes">Shop by size</a>
          <a class="btn btn--line" href="/brands/">Shop by brand</a>
        </div>
      </div>
      {hero.length >= 3 && (
        <div class="mosaic" aria-hidden="true">
          {hero.map((p) => <div class="mosaic__i"><img src={p.photos[0]} alt="" width="640" height="800" /></div>)}
        </div>
      )}
    </div>
  </section>

  <div class="features">
    <div class="feat"><Icon name="truck" /><div><b>Cash on delivery</b><span>Pay when the parcel arrives</span></div></div>
    <div class="feat"><Icon name="camera" /><div><b>Real photos</b><span>Of the exact pair you get</span></div></div>
    <div class="feat"><Icon name="shield" /><div><b>Honest condition</b><span>Rated out of 10, flaws listed</span></div></div>
    <div class="feat"><Icon name="package" /><div><b>Return policy</b><span>If a pair is not as described</span></div></div>
  </div>

  <div class="page">
    <section class="section" id="sizes">
      <div class="section__head"><h2>Shop by size</h2><a class="link" href="/size-guide/">Size guide</a></div>
      <div class="tiles">
        {tiles.map((t) => (
          <a class={`tile ${t.n === 0 && !t.img ? "tile--empty" : ""}`} href={`/size/${t.slug}/`}>
            <span class="tile__img">{t.img && <img src={t.img} alt="" width="640" height="800" loading="lazy" />}</span>
            <span class="tile__txt"><b>{t.label}</b><span>{t.n === 0 ? "None right now" : `${t.n} ${t.n === 1 ? "pair" : "pairs"} · ${t.blurb}`}</span></span>
          </a>
        ))}
      </div>
    </section>

    {brands.length > 0 && (
      <section class="section" id="brands">
        <div class="section__head"><h2>Shop by brand</h2><a class="link" href="/brands/">All brands</a></div>
        <div class="tiles">
          {brands.map((b) => (
            <a class="tile" href={`/brand/${b.slug}/`}>
              <span class="tile__img">{b.photo && <img src={b.photo} alt="" width="640" height="800" loading="lazy" />}</span>
              <span class="tile__txt"><b>{b.name}</b><span>{b.open === 0 ? "None right now" : `${b.open} ${b.open === 1 ? "pair" : "pairs"}`}</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section__head"><h2>New arrivals</h2><a class="link" href="/shoes/">View all</a></div>
      {arrivals.length > 0
        ? <ul class="grid">{arrivals.map((p) => <ProductCard p={p} idx={allProducts.indexOf(p)} />)}</ul>
        : <p class="empty">New pairs are being added. Please check again soon.</p>}
    </section>

    <section class="section">
      <div class="section__head"><h2>How it works</h2></div>
      <ol class="steps">
        <li><b>Pick your pair</b><span>Choose your size, check the photos and the condition, then add it to your cart.</span></li>
        <li><b>Confirm the order</b><span>Enter your delivery details and place your order.</span></li>
        <li><b>Pay on delivery</b><span>Pay cash when your parcel arrives.</span></li>
      </ol>
    </section>

    <div class="cta-band">
      <div>
        <h2>Cannot find your size?</h2>
        <p>Every pair is one of a kind and new ones are added often. Message us your size and we will tell you when one comes in.</p>
      </div>
      {ask ? <a class="btn" href={ask} rel="noopener">Message us on WhatsApp</a> : <a class="btn" href="/contact/">Contact us</a>}
    </div>
  </div>
</Base>
