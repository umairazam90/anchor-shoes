---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import ReviewCard from "../components/ReviewCard.astro";
import Stars from "../components/Stars.astro";
import { approvedReviews } from "../lib/db";
import { LIMITS } from "../lib/reviews";
const { allCategories, allProducts, allBrands, available, productsIn, waLink, settings } = Astro.locals.shop;

const fresh = [...available()].reverse();
const hero = fresh.slice(0, 3);
const arrivals = fresh.slice(0, 8);
const tiles = allCategories.map((c) => {
  const items = productsIn(c);
  const open = items.filter((p) => p.status === "available");
  return { ...c, n: open.length, img: (open[0] ?? items[0])?.photos[0] };
});
const brands = allBrands();
const ask = waLink("Hi Anchor Shoes, I am looking for a pair in size ___.");
// reviews must never break the home page: if they cannot be read, the section simply shows no reviews
const fb = await approvedReviews().catch(() => ({ reviews: [], count: 0, average: 0 }));
---

<Base>
  <section class="hero">
    <div class="hero__in">
      <div>
        <p class="eyebrow">{settings.tagline}</p>
        <h1>Good shoes, honestly described</h1>
        <p class="lead">Real photos of the exact pair, the condition out of 10, and every flaw written down. Pay cash when it arrives.</p>
        <div class="hero__cta">
          <a class="btn btn--brass" href="#sizes">Shop by size</a>
          <a class="btn btn--line" href="/brands/">Shop by brand</a>
        </div>
      </div>
      {hero.length >= 3 && (
        <div class="mosaic" aria-hidden="true">
          {hero.map((p) => <div class="mosaic__i"><img src={p.photos[0]} alt="" width="640" height="800" /></div>)}
        </div>
      )}
    </div>
  </section>

  <div class="features">
    <div class="feat"><Icon name="truck" /><div><b>Cash on delivery</b><span>Pay when the parcel arrives</span></div></div>
    <div class="feat"><Icon name="camera" /><div><b>Real photos</b><span>Of the exact pair you get</span></div></div>
    <div class="feat"><Icon name="shield" /><div><b>Honest condition</b><span>Rated out of 10, flaws listed</span></div></div>
    <div class="feat"><Icon name="package" /><div><b>Return policy</b><span>If a pair is not as described</span></div></div>
  </div>

  <div class="page">
    <section class="section" id="sizes">
      <div class="section__head"><h2>Shop by size</h2><a class="link" href="/size-guide/">Size guide</a></div>
      <div class="tiles">
        {tiles.map((t) => (
          <a class={`tile ${t.n === 0 && !t.img ? "tile--empty" : ""}`} href={`/size/${t.slug}/`}>
            <span class="tile__img">{t.img && <img src={t.img} alt="" width="640" height="800" loading="lazy" />}</span>
            <span class="tile__txt"><b>{t.label}</b><span>{t.n === 0 ? "None right now" : `${t.n} ${t.n === 1 ? "pair" : "pairs"} · ${t.blurb}`}</span></span>
          </a>
        ))}
      </div>
    </section>

    {brands.length > 0 && (
      <section class="section" id="brands">
        <div class="section__head"><h2>Shop by brand</h2><a class="link" href="/brands/">All brands</a></div>
        <div class="tiles">
          {brands.map((b) => (
            <a class="tile" href={`/brand/${b.slug}/`}>
              <span class="tile__img">{b.photo && <img src={b.photo} alt="" width="640" height="800" loading="lazy" />}</span>
              <span class="tile__txt"><b>{b.name}</b><span>{b.open === 0 ? "None right now" : `${b.open} ${b.open === 1 ? "pair" : "pairs"}`}</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section__head"><h2>New arrivals</h2><a class="link" href="/shoes/">View all</a></div>
      {arrivals.length > 0
        ? <ul class="grid">{arrivals.map((p) => <ProductCard p={p} idx={allProducts.indexOf(p)} />)}</ul>
        : <p class="empty">New pairs are being added. Please check again soon.</p>}
    </section>

    <section class="section">
      <div class="section__head"><h2>How it works</h2></div>
      <ol class="steps">
        <li><b>Pick your pair</b><span>Choose your size, check the photos and the condition, then add it to your cart.</span></li>
        <li><b>Confirm the order</b><span>Enter your delivery details and place your order.</span></li>
        <li><b>Pay on delivery</b><span>Pay cash when your parcel arrives.</span></li>
      </ol>
    </section>

    <div class="cta-band">
      <div>
        <h2>Cannot find your size?</h2>
        <p>Every pair is one of a kind and new ones are added often. Message us your size and we will tell you when one comes in.</p>
      </div>
      {ask ? <a class="btn" href={ask} rel="noopener">Message us on WhatsApp</a> : <a class="btn" href="/contact/">Contact us</a>}
    </div>

    <section class="section" id="reviews" data-rev>
      <div class="section__head"><h2>What customers say</h2></div>
      {fb.count > 0 && (
        <p class="rev-sum"><Stars rating={fb.average} size={22} /><b>{fb.average.toFixed(1)}</b><span>out of 5 · {fb.count} {fb.count === 1 ? "review" : "reviews"}</span></p>
      )}
      {fb.reviews.length > 0
        ? <ul class="rev-grid">{fb.reviews.map((r) => <ReviewCard r={r} />)}</ul>
        : <p class="empty" style="padding-top:0">No reviews yet. Bought a pair from us? Be the first to tell others how it went.</p>}

      <div class="rev-cta" data-rev-cta>
        <button class="btn btn--brass" type="button" aria-expanded="false" aria-controls="rev-form" data-rev-open>Write a review</button>
        <p class="muted small">We read every review before it appears here.</p>
      </div>

      <form class="rev-form" id="rev-form" data-rev-form novalidate hidden>
        <h3>Share your experience</h3>
        <fieldset data-field="rating">
          <legend>Your rating</legend>
          <div class="rate" role="radiogroup" aria-label="Your rating">
            {[5, 4, 3, 2, 1].map((n) => (
              <><input type="radio" name="rating" id={`rate-${n}`} value={String(n)} /><label for={`rate-${n}`}><span class="sr-only">{n} {n === 1 ? "star" : "stars"}</span></label></>
            ))}
          </div>
          <span class="rate-note" data-rev-note>Tap a star</span>
          <p class="err" data-err="rating" hidden></p>
        </fieldset>
        <div class="field">
          <label for="rev-name">Your name</label>
          <input id="rev-name" name="name" type="text" autocomplete="given-name" maxlength={LIMITS.nameMax} />
          <p class="err" data-err="name" hidden></p>
        </div>
        <div class="field">
          <label for="rev-city">City <span class="opt">(optional)</span></label>
          <input id="rev-city" name="city" type="text" autocomplete="address-level2" maxlength={LIMITS.cityMax} />
          <p class="err" data-err="city" hidden></p>
        </div>
        <div class="field">
          <label for="rev-comment">Your review</label>
          <textarea id="rev-comment" name="comment" rows="5" maxlength={LIMITS.commentMax} aria-describedby="rev-count"></textarea>
          <p class="rev-count" id="rev-count"><span data-rev-count>0</span> / {LIMITS.commentMax}</p>
          <p class="err" data-err="comment" hidden></p>
        </div>
        <div class="field">
          <label>Photos <span class="opt">(optional, up to {LIMITS.photos})</span></label>
          <ul class="rev-photos" data-rev-previews></ul>
          <label class="rev-add" data-rev-add><input type="file" accept="image/*" multiple data-rev-file />+ Add photos</label>
          <p class="help">Photos of the pair you received. Please do not add photos of people.</p>
          <p class="err" data-err="photos" hidden></p>
        </div>
        <div class="rev-hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn--block" type="submit" data-rev-send>Send review</button>
        <p class="help">Please do not put links or phone numbers in your review.</p>
        <p class="rev-msg" role="alert" data-rev-msg hidden></p>
      </form>

      <div class="rev-thanks" role="status" data-rev-thanks hidden>
        <b>Thank you!</b>
        <span>Your review has been sent. It will appear here once we have checked it.</span>
      </div>
    </section>
  </div>
</Base>

<script>
  import "../scripts/reviews";
</script>
