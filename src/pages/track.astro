---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { settings, waLink } from "../lib/shop";

const help = waLink("Hi Anchor Shoes, I cannot find my tracking number. My name is ___.");
---

<Base title="Track your order" nav="track" description="Track your Anchor Shoes order on the TCS website.">
  <div class="page" data-track data-tcs={settings.tcsTrackUrl}>
    <Crumbs trail={[{ label: "Track your order" }]} />
    <div class="prose">
      <h1>Track your order</h1>
      <p>We send you a TCS tracking number once your parcel is on its way. Tracking itself happens on the TCS website, so you always see their latest update.</p>

      <!-- shown when the link carries a number: /track/?n=1234567890 -->
      <div class="panel" data-result hidden style="margin-top:18px">
        <p class="small muted">Your TCS tracking number</p>
        <p class="big-num" data-number></p>
        <div class="cols2">
          <a class="btn" data-open href={settings.tcsTrackUrl} target="_blank" rel="noopener">Open TCS tracking</a>
          <button class="btn btn--line" type="button" data-copy>Copy number</button>
        </div>
        <p class="small muted" style="margin-top:12px">On the TCS page, paste the number and press track.</p>
        <p class="small" style="margin-top:8px"><a class="link" href="/track/" data-another>Track a different number</a></p>
      </div>

      <!-- shown when the page is opened without a number -->
      <form class="panel" data-form novalidate style="margin-top:18px">
        <div class="field">
          <label for="tn">TCS tracking number</label>
          <input id="tn" name="tn" inputmode="numeric" autocomplete="off" placeholder="For example 1234567890" maxlength="30" />
          <p class="err" data-error role="alert" hidden>Please enter the tracking number we sent you.</p>
        </div>
        <button class="btn btn--block" type="submit">Show tracking</button>
      </form>

      <ol class="steps" style="margin-top:24px">
        <li><b>Get your number</b><span>We message it to you when your parcel is handed to TCS.</span></li>
        <li><b>Open the link</b><span>Tap the link we sent, or type the number above.</span></li>
        <li><b>Follow it on TCS</b><span>You are taken to the TCS website to see where your parcel is.</span></li>
      </ol>

      <p class="small muted" style="margin-top:18px">
        Cannot find your number?
        {help ? <a class="link" href={help} rel="noopener">Message us on WhatsApp</a> : <a class="link" href="/contact/">Contact us</a>}
        with your name and phone number.
      </p>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-track]")!;
  const result = root.querySelector<HTMLElement>("[data-result]")!;
  const form = root.querySelector<HTMLFormElement>("[data-form]")!;
  const numEl = root.querySelector<HTMLElement>("[data-number]")!;
  const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy]")!;
  const err = root.querySelector<HTMLElement>("[data-error]")!;
  const input = root.querySelector<HTMLInputElement>("#tn")!;

  const clean = (v: string | null) => (v ?? "").replace(/[^A-Za-z0-9-]/g, "").slice(0, 30);

  function show(n: string) {
    numEl.textContent = n;
    result.hidden = false;
    form.hidden = true;
    history.replaceState(null, "", "?n=" + encodeURIComponent(n));
  }

  copyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(numEl.textContent ?? "");
      copyBtn.textContent = "Copied";
    } catch {
      copyBtn.textContent = "Select the number above and copy it";
    }
    setTimeout(() => (copyBtn.textContent = "Copy number"), 2500);
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const n = clean(input.value);
    err.hidden = n.length >= 6;
    if (n.length >= 6) show(n);
  });

  const fromLink = clean(new URLSearchParams(location.search).get("n"));
  if (fromLink.length >= 6) show(fromLink);
</script>
