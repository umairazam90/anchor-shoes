---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { CHARTS, type ChartRow } from "../lib/sizes";
const { allCategories } = Astro.locals.shop;

const tables: { id: string; title: string; note: string; rows: ChartRow[] }[] = [
  { id: "nike", title: "Nike and Jordan", note: "Men's sizes from the Nike size chart.", rows: CHARTS.nike.rows },
  { id: "adidas", title: "adidas", note: "Men's sizes from the adidas size chart. adidas sells in thirds of an EU size, for example 42 2/3.", rows: CHARTS.adidas.rows },
];
---

<Base title="Size guide" nav="sizes" description="Men's EU, UK and US shoe size charts for Nike and adidas with foot length in cm, and how to measure your foot.">
  <div class="page">
    <Crumbs trail={[{ label: "Size guide" }]} />
    <div class="prose">
      <h1>Size guide</h1>
      <p>Men's sizes. UK and US sizes are not the same from brand to brand, so we show a separate chart for each. The most reliable way to choose is your <b>foot length in cm</b>: measure it below, then find the closest row.</p>

      <div class="notice" style="margin-top:16px">
        <p><b>Foot length is not the "CM" on a shoe box.</b> The number printed on a box is the shoe size, and it is bigger than your foot. Use the foot length column below.</p>
      </div>

      <h2 class="table-title" id="measure">How to measure your foot</h2>
      <ol class="steps">
        <li><b>Stand on paper</b><span>Put a sheet of paper against a wall and stand on it with your heel touching the wall.</span></li>
        <li><b>Mark your longest toe</b><span>Make a small mark in front of your longest toe.</span></li>
        <li><b>Measure in cm</b><span>Measure from the wall to the mark. Do both feet and use the longer one, then find the closest row in the chart.</span></li>
      </ol>
      <p style="margin-top:12px">If your foot falls between two sizes, choose the larger size. If you are still unsure, message us and we will help.</p>

      {tables.map((t) => (
        <>
          <h2 class="table-title" id={t.id}>{t.title}</h2>
          <p>{t.note}</p>
          <div class="table-wrap" style="margin-top:12px">
            <table>
              <thead><tr><th>EU</th><th>UK</th><th>US</th><th>Foot length (cm)</th></tr></thead>
              <tbody>
                {t.rows.map((r) => <tr><td>{r.euLabel}</td><td>{r.uk}</td><td>{r.us}</td><td>{r.foot}</td></tr>)}
              </tbody>
            </table>
          </div>
        </>
      ))}

      <h2 class="table-title" id="other">Other brands</h2>
      <p>Some brands, such as H&amp;M, print only an EU size on the shoe, and sizing can run a little small or large. For these pairs we list the EU size printed on the shoe. Ask us if you would like the measured length of the insole of any pair.</p>

      <h2 class="table-title">Shop by size</h2>
      <div class="pills">
        {allCategories.map((c) => <a class="pill" href={`/size/${c.slug}/`}>{c.label}</a>)}
      </div>
    </div>
  </div>
</Base>
