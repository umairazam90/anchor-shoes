---
import Base from "../../../layouts/Base.astro";
import Crumbs from "../../../components/Crumbs.astro";
import ShopGrid from "../../../components/ShopGrid.astro";
import { allCategories, allProducts, productsIn, sizesIn, sizeSlug, type Category } from "../../../lib/shop";
import { fullSize, fmt } from "../../../lib/sizes";

export function getStaticPaths() {
  return allCategories.flatMap((c) =>
    sizesIn(c).map((eu) => ({ params: { range: c.slug, eu: sizeSlug(eu) }, props: { cat: c, eu } })),
  );
}
const { cat, eu } = Astro.props as { cat: Category; eu: number };
const items = allProducts.filter((p) => p.size.eu === eu);
const s = fullSize({ eu });
const sizes = sizesIn(cat);
const count = (n: number) => productsIn(cat).filter((p) => p.size.eu === n && p.status === "available").length;
---

<Base title={`EU ${eu} shoes`} nav="shop" description={`Pre-loved shoes in EU ${eu} (UK ${fmt(s.uk)}, US ${fmt(s.us)}) with photos, condition and price.`}>
  <div class="page">
    <Crumbs trail={[{ label: "Shop by size", href: "/shoes/" }, { label: cat.label, href: `/size/${cat.slug}/` }, { label: `EU ${eu}` }]} />
    <div class="pagehead">
      <h1>EU {eu} shoes</h1>
      <p>UK {fmt(s.uk)} · US {fmt(s.us)} · foot length about {fmt(s.cm)} cm. Fit changes by brand, so check each pair's own size.</p>
    </div>

    <div class="pills" aria-label="Exact size">
      <a class="pill" href={`/size/${cat.slug}/`}>All {cat.label}</a>
      {sizes.map((n) => <a class="pill" href={`/size/${cat.slug}/${sizeSlug(n)}/`} aria-current={n === eu ? "page" : undefined}>EU {n} <small>{count(n)}</small></a>)}
    </div>

    <ShopGrid products={items} />
  </div>
</Base>
