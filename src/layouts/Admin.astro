---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/global.css";
import "../styles/admin.css";
import { pendingReviewCount } from "../lib/db";

interface Props { title: string; active?: "pairs" | "add" | "reviews" | "settings" | "admins"; bare?: boolean }
// bare = the sign-in and setup screens: just the logo, no menu, no footer, no database call
const { title, active, bare = false } = Astro.props;
const email = Astro.locals.admin?.email ?? "";
const via = Astro.locals.admin?.via;
let waiting = 0; // reviews waiting for approval (shown as a number on the Reviews link)
if (!bare) {
  try { waiting = await pendingReviewCount(); } catch { /* database not connected: the page itself explains it */ }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17223B" />
    <title>{title} | Anchor Shoes admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="adm">
    {bare ? (
      <header class="adm-hdr"><div class="adm-wrap adm-hdr__row"><span class="adm-brand"><img src="/brand/logo-header.svg" alt="Anchor Shoes" /><span>Admin</span></span></div></header>
    ) : (
    <header class="adm-hdr">
      <div class="adm-wrap adm-hdr__row">
        <a class="adm-brand" href="/admin/"><img src="/brand/logo-header.svg" alt="Anchor Shoes" /><span>Admin</span></a>
        <nav class="adm-nav" aria-label="Admin">
          <a href="/admin/" aria-current={active === "pairs" ? "page" : undefined}>Pairs</a>
          <a href="/admin/pair/new/" aria-current={active === "add" ? "page" : undefined}>Add pair</a>
          <a href="/admin/reviews/" aria-current={active === "reviews" ? "page" : undefined}>Reviews{waiting > 0 && <span class="adm-count" aria-label={`${waiting} waiting`}>{waiting}</span>}</a>
          <a href="/admin/settings/" aria-current={active === "settings" ? "page" : undefined}>Settings</a>
          <a href="/" target="_blank" rel="noopener">View shop ↗</a>
        </nav>
      </div>
    </header>
    )}
    <main class="adm-main"><div class="adm-wrap"><slot /></div></main>
    {!bare && (
      <footer class="adm-foot">
        <div class="adm-wrap adm-foot__row">
          <span>Signed in as {email}{via === "dev" && " (local test sign-in)"}{via === "access" && " (Cloudflare Access)"}</span>
          <a href="/admin/admins/" aria-current={active === "admins" ? "page" : undefined}>Logins and password</a>
          {via === "password" && (
            <form method="post" action="/api/admin/logout/"><button type="submit" class="adm-link">Sign out</button></form>
          )}
        </div>
      </footer>
    )}
    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
  </body>
</html>
