{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor-shoes",
  "compatibility_date": "2026-11-01",

  // The Astro adapter fills in the Worker entry and the static assets folder at build time.
  // Both bindings are named explicitly. With bare bindings (no ID or name), the first production
  // deploy failed (2026-11-21, code 10057): Wrangler marked PHOTOS "inherited" from the live version,
  // which had no such binding. The database ID is the one Cloudflare created for this Worker's DB.
  "d1_databases": [
    { "binding": "DB", "database_id": "dce04558-b3b1-4b4d-9c07-4362fc88caee" }, // pairs + settings (tables are created by src/lib/db.ts)
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "anchor-shoes-photos" }], // uploaded photos, served at /img/...

  // Admin sign-in (Cloudflare Access). Filled in once Access is set up, see SETUP-ADMIN.md.
  // Not secrets: the AUD tag only identifies the Access application.
  "vars": {
    "TEAM_DOMAIN": "", // https://<your-team>.cloudflareaccess.com
    "POLICY_AUD": "", // the Access application's AUD tag
    "ADMIN_EMAILS": "" // optional extra allow-list, comma separated
  }
}
